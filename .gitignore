# Virtual environment
.venv/

# Python cache
__pycache__/
*.py[cod]

# Test cache：pytest 跑测试时自动生成的缓存
.pytest_cache/

# Test data：测试数据目录
tests/

# Runtime data (session persistence)：会话持久化存储目录
# 当前 config.yaml 是 session_mode: ephemeral ，根本不会创建/使用它；
# 即使改为 persistent ， FileSessionStore 启动时也会 mkdir(parents=True, exist_ok=True) 自动创建
data/

# 指导与配置文档
docs/
config/config.yaml

# Local secrets
.env

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
